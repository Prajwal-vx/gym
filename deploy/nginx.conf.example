# Example hardened nginx configuration for the IRONFORGE static site.
# Copy to /etc/nginx/sites-available/gym.conf, adjust server_name and
# certificate paths, enable with a symlink, then `nginx -t && systemctl reload nginx`.
#
# Notes:
#   - This is an EXAMPLE: review TLS paths, logs, and rate limits for your host.
#   - Header CSP here adds frame-ancestors, which a <meta> CSP cannot express.

server {
    listen 80;
    listen [::]:80;
    server_name gym.example.com;

    # ACME challenge exception, then force HTTPS for everything else.
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name gym.example.com;

    # --- TLS ---
    ssl_certificate     /etc/letsencrypt/live/gym.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gym.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:gym_ssl:10m;
    ssl_session_tickets off;

    # --- Site root: static files only, read-only for the service user ---
    root /var/www/gym;
    index index.html;

    # --- Security headers ---
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # Header CSP: same policy as the <meta> tag + frame-ancestors + upgrade-insecure-requests.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" always;

    # --- Anti-traversal / no listing / deny hidden files ---
    autoindex off;
    location ~ /\.(?!well-known) { deny all; }
    location ~ /\.git { deny all; }

    # --- Caching for hashed/static assets; never cache the HTML shell ---
    location ~* \.(?:css|js|png|jpe?g|webp|gif|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        # Headers are inherited only if re-declared inside this block:
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" always;
    }

    # --- Size limits & timeouts ---
    client_max_body_size 1m;   # static site: uploads stay client-side; keep tiny
    client_body_timeout 10s;
    keepalive_timeout 15s;

    # --- Basic abuse protection for the single page ---
    limit_req_zone $binary_remote_addr zone=gym_req:10m rate=30r/m;
    limit_req zone=gym_req burst=60 nodelay;

    # --- Safe error pages (no version banners) ---
    error_page 404 /index.html;
    server_tokens off;
}
